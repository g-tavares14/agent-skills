{
  "description": "Protect simplify-ignore blocks from Claude Code Edit, MultiEdit, and Write calls.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|MultiEdit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/simplify_ignore_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking protected code blocks"
          }
        ]
      }
    ]
  }
}
