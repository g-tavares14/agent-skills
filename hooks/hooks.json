{
  "description": "Protect simplify-ignore blocks from Codex apply_patch edits.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/simplify_ignore_guard.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\simplify_ignore_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking protected code blocks"
          }
        ]
      }
    ]
  }
}
