{
  "description": "Protect simplify-ignore blocks from edits, hold the implementer and reviewer agents to their Bash rules, and report project setup status at session start.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/project_status.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Edit|MultiEdit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/simplify_ignore_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking protected code blocks"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_bash_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
